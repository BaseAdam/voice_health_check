# Dev-only fallback for keys not set in the app (Ustawienia).
# EXPO_PUBLIC_* values are inlined into the JS bundle - never ship real keys this way.
# Copy to .env (git-ignored) and restart `npx expo start`.
# Expo CLI also logs these values in plain text to .expo/dev/logs/start.log (git-ignored):
# share the project via git only, never as a zipped folder.
EXPO_PUBLIC_ELEVENLABS_API_KEY=
EXPO_PUBLIC_GROQ_API_KEY=
